# HubSphere Enterprise V4 — Environment Configuration
# PostgreSQL / Supabase Connection URL
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=public"

# App Environment
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://hupspherev4.vercel.app"

# AI Workforce Provider (Optional - Defaults to Independent Orchestrator)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Telephony Webhook Security Secret
SIM_COMPANION_WEBHOOK_SECRET="sec_hubsphere_telecom_v4_prod"
